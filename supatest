<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Supabase Test</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    body{
      font-family: Arial, sans-serif;
      background:#f5f7fb;
      display:flex;
      justify-content:center;
      align-items:center;
      height:100vh;
      margin:0;
    }

    .box{
      width:320px;
      background:white;
      padding:25px;
      border-radius:18px;
      box-shadow:0 10px 30px rgba(0,0,0,0.08);
    }

    h2{
      margin-top:0;
      text-align:center;
    }

    input{
      width:100%;
      padding:12px;
      margin-bottom:12px;
      border-radius:10px;
      border:1px solid #dcdcdc;
      box-sizing:border-box;
      font-size:14px;
    }

    button{
      width:100%;
      padding:12px;
      border:none;
      border-radius:10px;
      background:#06b6d4;
      color:white;
      font-size:15px;
      cursor:pointer;
    }

    button:hover{
      opacity:0.9;
    }

    #status{
      margin-top:15px;
      text-align:center;
      font-size:14px;
      word-break:break-word;
    }
  </style>
</head>
<body>

<div class="box">
  <h2>Supabase Test</h2>

  <input type="text" id="name" placeholder="Enter Name">
  <input type="text" id="mobile" placeholder="Enter Mobile">

  <button onclick="saveLead()">
    Save Data
  </button>

  <div id="status"></div>
</div>

<script>

  // =========================
  // SUPABASE CONFIG
  // =========================

  const SUPABASE_URL = "https://rsnywjwcltuicfisqkdo.supabase.co";
  const SUPABASE_KEY = "sb_publishable_86Crft4pqsX_ubUwnSdX6A_9fPl4T2M";

  // =========================
  // CREATE CLIENT
  // =========================

  const supabaseClient = supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );

  // =========================
  // SAVE FUNCTION
  // =========================

  async function saveLead(){

    const status = document.getElementById("status");

    const name = document.getElementById("name").value;
    const mobile = document.getElementById("mobile").value;

    if(!name || !mobile){
      status.innerHTML = "Please fill all fields";
      status.style.color = "red";
      return;
    }

    status.innerHTML = "Saving...";
    status.style.color = "#333";

    const { data, error } = await supabaseClient
      .from("leads")
      .insert([
        {
          name:name,
          mobile:mobile
        }
      ]);

    console.log("DATA:", data);
    console.log("ERROR:", error);

    if(error){

      status.innerHTML = error.message;
      status.style.color = "red";

    }else{

      status.innerHTML = "Data Saved Successfully";
      status.style.color = "green";

      document.getElementById("name").value = "";
      document.getElementById("mobile").value = "";

    }

  }

</script>

</body>
</html>
